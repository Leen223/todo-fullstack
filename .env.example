# Copy this file to .env and fill in your own values. Never commit .env.
DB_HOST=your_db_host
DB_PORT=your_db_port
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
# Domain of the frontend that may call the API, e.g. https://todo.example.com
# Never use "*". Leave empty if the frontend and the API share one domain.
CORS_ORIGIN=
# At least 32 random characters. Generate one with:  php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=your_long_random_secret
# Token lifetime in seconds (default 3600 = 1 hour)
JWT_EXPIRES_IN=3600
